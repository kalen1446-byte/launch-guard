# Copy this file to .env, put your Solami RPC key (Dashboard → API Keys) below,
# then run `npm run probe` — it finds the working endpoint format and fills in the URLs.
SOLAMI_API_KEY=YOUR_KEY
SOLAMI_RPC_URL=https://rpc.solami.fast/sol?api_key=YOUR_KEY
SOLAMI_WS_URL=wss://rpc.solami.fast/ws/sol?api_key=YOUR_KEY

# Optional: Solami Blur / Data API (decoded trades) for live behaviour flags
SOLAMI_API_KEY=
SOLAMI_API_BASE=https://api.solami.dev

# Local API port for the dashboard
PORT=8787
# Public address of the dashboard once deployed (used in alert links)
PUBLIC_URL=

# Optional: Telegram alerts (create a bot with @BotFather, add it as admin to your channel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@your_channel
# Only alert launches at or above this score (35 = HIGH and CRITICAL)
ALERT_MIN_SCORE=35
